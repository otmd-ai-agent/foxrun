{
  "name": "Foxrun disposable demo · local Gemma",
  "dockerComposeFile": "compose.yaml",
  "service": "demo",
  "workspaceFolder": "/workspaces/foxrun",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Foxrun demo (private)",
      "onAutoForward": "openPreview",
      "protocol": "http",
      "visibility": "private"
    }
  },
  "postStartCommand": "python3 demo/start.py",
  "shutdownAction": "stopCompose",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none",
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "chat.disableAIFeatures": true
      }
    }
  }
}
